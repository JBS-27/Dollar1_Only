# =============================================================================
# $1 Only — environment
# Copy to .env for local development. Never commit real secrets.
# Stripe Secret Key and webhook secret must NEVER be prefixed with VITE_.
# =============================================================================

# --- Public (safe in the browser) -------------------------------------------
# Display only. The server is the source of truth for the charged amount.
VITE_PAY_AMOUNT=1.50
VITE_NET_AMOUNT=1
VITE_CURRENCY=USD

# Optional. If omitted, the client talks to /api on the same origin.
# VITE_API_URL=

# Supabase publishable values (anon key is designed for the browser).
# Enable Realtime on public.live_signals — see supabase/schema.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# UPI (India). The QR is generated from these values. No amount field is editable.
VITE_UPI_ID=
VITE_UPI_NAME=$1 Only
# Optional INR amount encoded into the QR. Leave empty to encode ID only.
VITE_UPI_AMOUNT_INR=

# Show an in-app demo witness control. Keep false in production.
VITE_ENABLE_DEMO=true

# --- Server only (never expose to the frontend) -----------------------------
PORT=8787
NODE_ENV=development

# Allowed browser origin(s), comma-separated. Required for CORS.
FRONTEND_URL=http://localhost:5173

# Locked charge. 150 = $1.50 USD. Change this AND the VITE_PAY_AMOUNT together.
STRIPE_CHARGE_AMOUNT_CENTS=150
STRIPE_CURRENCY=usd
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Service role bypasses RLS so the webhook can insert. Never ship this to Vite.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# When true, POST /api/demo may insert a signal without Stripe (local / staging).
ENABLE_DEMO=true

# Optional extra gate for honor-system UPI confirms. If set, the client must send it.
# UPI_CONFIRM_TOKEN=
